{
  "info": {
    "name": "Talenavi Todo API",
    "description": "Backend Test - Talenavi. Create Todo + Excel Report endpoints.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:8000/api" },
    { "key": "todo_id", "value": "1" }
  ],
  "item": [
    {
      "name": "1. Create Todo",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Accept", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Design database schema\",\n  \"assignee\": \"John\",\n  \"due_date\": \"2026-09-01\",\n  \"time_tracked\": 2.5,\n  \"priority\": \"high\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/todos",
          "host": ["{{base_url}}"],
          "path": ["todos"]
        },
        "description": "status is intentionally omitted here to demonstrate it defaults to 'pending'."
      }
    },
    {
      "name": "2. List Todos (with optional filters)",
      "request": {
        "method": "GET",
        "header": [{ "key": "Accept", "value": "application/json" }],
        "url": {
          "raw": "{{base_url}}/todos?title=&assignee=&start=&end=&min=&max=&status=&priority=",
          "host": ["{{base_url}}"],
          "path": ["todos"],
          "query": [
            { "key": "title", "value": "", "description": "partial match, e.g. bug" },
            { "key": "assignee", "value": "", "description": "comma separated, e.g. John,Doe" },
            { "key": "start", "value": "", "description": "due_date range start YYYY-MM-DD" },
            { "key": "end", "value": "", "description": "due_date range end YYYY-MM-DD" },
            { "key": "min", "value": "", "description": "time_tracked min" },
            { "key": "max", "value": "", "description": "time_tracked max" },
            { "key": "status", "value": "", "description": "comma separated, e.g. pending,in_progress" },
            { "key": "priority", "value": "", "description": "comma separated, e.g. low,high" }
          ]
        }
      }
    },
    {
      "name": "3. Get Todo By Id",
      "request": {
        "method": "GET",
        "header": [{ "key": "Accept", "value": "application/json" }],
        "url": {
          "raw": "{{base_url}}/todos/{{todo_id}}",
          "host": ["{{base_url}}"],
          "path": ["todos", "{{todo_id}}"]
        }
      }
    },
    {
      "name": "4. Update Todo",
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Accept", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"in_progress\",\n  \"time_tracked\": 5\n}"
        },
        "url": {
          "raw": "{{base_url}}/todos/{{todo_id}}",
          "host": ["{{base_url}}"],
          "path": ["todos", "{{todo_id}}"]
        }
      }
    },
    {
      "name": "5. Delete Todo",
      "request": {
        "method": "DELETE",
        "header": [{ "key": "Accept", "value": "application/json" }],
        "url": {
          "raw": "{{base_url}}/todos/{{todo_id}}",
          "host": ["{{base_url}}"],
          "path": ["todos", "{{todo_id}}"]
        }
      }
    },
    {
      "name": "6. Export Excel Report - No Filter",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/todos/export",
          "host": ["{{base_url}}"],
          "path": ["todos", "export"]
        }
      }
    },
    {
      "name": "7. Export Excel Report - With Filters",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/todos/export?title=&assignee=John,Doe&start=2026-01-01&end=2026-12-31&min=0&max=100&status=pending,in_progress&priority=low,high",
          "host": ["{{base_url}}"],
          "path": ["todos", "export"],
          "query": [
            { "key": "title", "value": "", "description": "partial match" },
            { "key": "assignee", "value": "John,Doe" },
            { "key": "start", "value": "2026-01-01" },
            { "key": "end", "value": "2026-12-31" },
            { "key": "min", "value": "0" },
            { "key": "max", "value": "100" },
            { "key": "status", "value": "pending,in_progress" },
            { "key": "priority", "value": "low,high" }
          ]
        },
        "description": "Change the query param values in the params tab to demo different filter combinations without touching the URL structure."
      }
    }
  ]
}
